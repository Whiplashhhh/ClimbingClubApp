# Copier vers .env (gitignoré) et adapter. Aucune valeur réelle ici.

# PostgreSQL
POSTGRES_DB=belay
POSTGRES_USER=belay
POSTGRES_PASSWORD=change-me

# MinIO (stockage objet S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
# URL de MinIO vue par le navigateur (URLs signées) — adapter si l'hôte n'est pas localhost
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# Backend
# SESSION_COOKIE_SECURE=true  # en production (HTTPS)
