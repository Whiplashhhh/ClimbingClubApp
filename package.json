{
  "name": "belay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2"
  },
  "lint-staged": {
    "frontend/**/*.{ts,vue,js,mjs}": [
      "pnpm --dir frontend exec eslint --fix"
    ],
    "frontend/**/*.{json,css,md}": [
      "pnpm --dir frontend exec prettier --write"
    ]
  }
}
