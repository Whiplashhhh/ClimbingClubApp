{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Belay API",
    "description" : "Multi-tenant climbing club management API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "name" : "feed",
    "description" : "Home feed: posts with an audience, aggregated per user (tenant-scoped)"
  }, {
    "name" : "auth",
    "description" : "Registration, login and session management"
  }, {
    "name" : "members",
    "description" : "Organization members management (tenant-scoped)"
  } ],
  "paths" : {
    "/api/posts" : {
      "post" : {
        "tags" : [ "feed" ],
        "summary" : "Publish an INFO or CANCELLATION post (ORG audience: admins; COACH_STUDENTS: coaches)",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreatePostRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "403" : {
            "description" : "Role not allowed to publish to the requested audience",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPostResponse"
                }
              }
            }
          },
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPostResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/poster" : {
      "post" : {
        "tags" : [ "feed" ],
        "summary" : "Publish a POSTER post with an image (content-sniffed JPEG/PNG/WebP, max 5 MB)",
        "operationId" : "createPoster",
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "meta" : {
                    "$ref" : "#/components/schemas/CreatePosterRequest"
                  },
                  "image" : {
                    "type" : "string",
                    "format" : "binary"
                  }
                },
                "required" : [ "image", "meta" ]
              }
            }
          }
        },
        "responses" : {
          "400" : {
            "description" : "File content is not a supported image",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPostResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Role not allowed to publish to the requested audience",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPostResponse"
                }
              }
            }
          },
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPostResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{memberId}/approve" : {
      "post" : {
        "tags" : [ "members" ],
        "summary" : "Approve a pending member (admins only)",
        "operationId" : "approve",
        "parameters" : [ {
          "name" : "memberId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "description" : "Member not found in the caller's organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Member is not pending",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register" : {
      "post" : {
        "tags" : [ "auth" ],
        "summary" : "Register a new account, creating or joining an organization",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Account created and session established",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "joinSlug does not match any organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Email already registered",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login" : {
      "post" : {
        "tags" : [ "auth" ],
        "summary" : "Authenticate with email and password (server session cookie)",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Session established",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Invalid credentials",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{memberId}/role" : {
      "patch" : {
        "tags" : [ "members" ],
        "summary" : "Change a member's role (admins only, OWNER excluded)",
        "operationId" : "changeRole",
        "parameters" : [ {
          "name" : "memberId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateRoleRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "404" : {
            "description" : "Member not found in the caller's organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/members" : {
      "get" : {
        "tags" : [ "members" ],
        "summary" : "List active members of the caller's organization",
        "operationId" : "listMembers",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/MemberResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/members/pending" : {
      "get" : {
        "tags" : [ "members" ],
        "summary" : "List members awaiting approval (admins only)",
        "operationId" : "listPendingMembers",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PendingMemberResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/feed" : {
      "get" : {
        "tags" : [ "feed" ],
        "summary" : "Aggregated feed of the caller: ORG posts plus COACH_STUDENTS posts they can see",
        "operationId" : "feed",
        "parameters" : [ {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me" : {
      "get" : {
        "tags" : [ "auth" ],
        "summary" : "Current authenticated user profile",
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf" : {
      "get" : {
        "tags" : [ "auth" ],
        "summary" : "Prime the CSRF cookie and return the current token",
        "operationId" : "csrf",
        "parameters" : [ {
          "name" : "token",
          "in" : "query",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/CsrfToken"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/{postId}" : {
      "delete" : {
        "tags" : [ "feed" ],
        "summary" : "Delete a post (author or admins)",
        "operationId" : "delete",
        "parameters" : [ {
          "name" : "postId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "description" : "Post not found in the caller's organization"
          },
          "204" : {
            "description" : "No Content"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreatePostRequest" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "description" : "INFO or CANCELLATION — posters go through POST /api/posts/poster",
            "enum" : [ "INFO", "CANCELLATION", "POSTER" ]
          },
          "audience" : {
            "type" : "string",
            "enum" : [ "ORG", "COACH_STUDENTS" ]
          },
          "title" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "body" : {
            "type" : "string",
            "maxLength" : 5000,
            "minLength" : 0
          }
        },
        "required" : [ "audience", "title", "type" ]
      },
      "FeedPostResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "type" : {
            "type" : "string",
            "enum" : [ "INFO", "CANCELLATION", "POSTER" ]
          },
          "audience" : {
            "type" : "string",
            "enum" : [ "ORG", "COACH_STUDENTS" ]
          },
          "title" : {
            "type" : "string"
          },
          "body" : {
            "type" : "string"
          },
          "imageUrl" : {
            "type" : "string",
            "description" : "Short-lived signed URL of the poster image (POSTER posts only)"
          },
          "authorId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "authorDisplayName" : {
            "type" : "string"
          },
          "authorRole" : {
            "type" : "string",
            "enum" : [ "OWNER", "ADMIN", "COACH", "MEMBER" ]
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "CreatePosterRequest" : {
        "type" : "object",
        "properties" : {
          "audience" : {
            "type" : "string",
            "enum" : [ "ORG", "COACH_STUDENTS" ]
          },
          "title" : {
            "type" : "string",
            "maxLength" : 200,
            "minLength" : 0
          },
          "body" : {
            "type" : "string",
            "maxLength" : 5000,
            "minLength" : 0
          }
        },
        "required" : [ "audience", "title" ]
      },
      "MemberResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "displayName" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "OWNER", "ADMIN", "COACH", "MEMBER" ]
          }
        }
      },
      "CreateOrganization" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "climbingType" : {
            "type" : "string",
            "enum" : [ "BOULDER", "ROPES", "BOTH" ]
          }
        },
        "required" : [ "climbingType", "name" ]
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 255,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 72,
            "minLength" : 8
          },
          "displayName" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "createOrganization" : {
            "$ref" : "#/components/schemas/CreateOrganization"
          },
          "joinSlug" : {
            "type" : "string",
            "description" : "Slug of the organization to join as a pending member",
            "maxLength" : 140,
            "minLength" : 0
          },
          "createMode" : {
            "type" : "boolean"
          },
          "joinMode" : {
            "type" : "boolean"
          }
        },
        "required" : [ "displayName", "email", "password" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "OWNER", "ADMIN", "COACH", "MEMBER" ]
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "ACTIVE", "DISABLED" ]
          },
          "organization" : {
            "$ref" : "#/components/schemas/OrganizationSummary"
          }
        }
      },
      "OrganizationSummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          },
          "climbingType" : {
            "type" : "string",
            "enum" : [ "BOULDER", "ROPES", "BOTH" ]
          }
        }
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 255,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 72,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "UpdateRoleRequest" : {
        "type" : "object",
        "properties" : {
          "role" : {
            "type" : "string",
            "enum" : [ "OWNER", "ADMIN", "COACH", "MEMBER" ]
          }
        },
        "required" : [ "role" ]
      },
      "PendingMemberResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          }
        }
      },
      "FeedPageResponse" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/FeedPostResponse"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "hasNext" : {
            "type" : "boolean"
          }
        }
      },
      "CsrfToken" : {
        "type" : "object",
        "properties" : {
          "parameterName" : {
            "type" : "string"
          },
          "token" : {
            "type" : "string"
          },
          "headerName" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
