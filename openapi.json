{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Belay API",
    "description" : "Multi-tenant climbing club management API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "name" : "auth",
    "description" : "Registration, login and session management"
  }, {
    "name" : "members",
    "description" : "Organization members management (tenant-scoped)"
  } ],
  "paths" : {
    "/api/members/{memberId}/approve" : {
      "post" : {
        "tags" : [ "members" ],
        "summary" : "Approve a pending member (admins only)",
        "operationId" : "approve",
        "parameters" : [ {
          "name" : "memberId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "description" : "Member not found in the caller's organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Member is not pending",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register" : {
      "post" : {
        "tags" : [ "auth" ],
        "summary" : "Register a new account, creating or joining an organization",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Account created and session established",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "joinSlug does not match any organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Email already registered",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login" : {
      "post" : {
        "tags" : [ "auth" ],
        "summary" : "Authenticate with email and password (server session cookie)",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Session established",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Invalid credentials",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{memberId}/role" : {
      "patch" : {
        "tags" : [ "members" ],
        "summary" : "Change a member's role (admins only, OWNER excluded)",
        "operationId" : "changeRole",
        "parameters" : [ {
          "name" : "memberId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateRoleRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "404" : {
            "description" : "Member not found in the caller's organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/members" : {
      "get" : {
        "tags" : [ "members" ],
        "summary" : "List active members of the caller's organization",
        "operationId" : "listMembers",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/MemberResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/members/pending" : {
      "get" : {
        "tags" : [ "members" ],
        "summary" : "List members awaiting approval (admins only)",
        "operationId" : "listPendingMembers",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PendingMemberResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me" : {
      "get" : {
        "tags" : [ "auth" ],
        "summary" : "Current authenticated user profile",
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf" : {
      "get" : {
        "tags" : [ "auth" ],
        "summary" : "Prime the CSRF cookie and return the current token",
        "operationId" : "csrf",
        "parameters" : [ {
          "name" : "token",
          "in" : "query",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/CsrfToken"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "MemberResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "displayName" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "OWNER", "ADMIN", "COACH", "MEMBER" ]
          }
        }
      },
      "CreateOrganization" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "climbingType" : {
            "type" : "string",
            "enum" : [ "BOULDER", "ROPES", "BOTH" ]
          }
        },
        "required" : [ "climbingType", "name" ]
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 255,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 72,
            "minLength" : 8
          },
          "displayName" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "createOrganization" : {
            "$ref" : "#/components/schemas/CreateOrganization"
          },
          "joinSlug" : {
            "type" : "string",
            "description" : "Slug of the organization to join as a pending member",
            "maxLength" : 140,
            "minLength" : 0
          },
          "createMode" : {
            "type" : "boolean"
          },
          "joinMode" : {
            "type" : "boolean"
          }
        },
        "required" : [ "displayName", "email", "password" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "email" : {
            "type" : "string"
          },
          "displayName" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "OWNER", "ADMIN", "COACH", "MEMBER" ]
          },
          "status" : {
            "type" : "string",
            "enum" : [ "PENDING", "ACTIVE", "DISABLED" ]
          },
          "organization" : {
            "$ref" : "#/components/schemas/OrganizationSummary"
          }
        }
      },
      "OrganizationSummary" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "slug" : {
            "type" : "string"
          },
          "climbingType" : {
            "type" : "string",
            "enum" : [ "BOULDER", "ROPES", "BOTH" ]
          }
        }
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 255,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 72,
            "minLength" : 0
          }
        },
        "required" : [ "email", "password" ]
      },
      "UpdateRoleRequest" : {
        "type" : "object",
        "properties" : {
          "role" : {
            "type" : "string",
            "enum" : [ "OWNER", "ADMIN", "COACH", "MEMBER" ]
          }
        },
        "required" : [ "role" ]
      },
      "PendingMemberResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          }
        }
      },
      "CsrfToken" : {
        "type" : "object",
        "properties" : {
          "parameterName" : {
            "type" : "string"
          },
          "token" : {
            "type" : "string"
          },
          "headerName" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
