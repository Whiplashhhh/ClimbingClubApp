{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Belay API",
    "description" : "Multi-tenant climbing club management API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "name" : "notifications",
    "description" : "In-app notifications of the authenticated member"
  }, {
    "name" : "feed",
    "description" : "Home feed: posts with an audience, aggregated per user (tenant-scoped)"
  }, {
    "name" : "slots",
    "description" : "Weekly recurring training slots and their member groups (tenant-scoped)"
  }, {
    "name" : "auth",
    "description" : "Registration, login and session management"
  }, {
    "name" : "members",
    "description" : "Organization members management (tenant-scoped)"
  } ],
  "paths" : {
    "/api/slots/{slotId}" : {
      "put" : {
        "tags" : [ "slots" ],
        "summary" : "Update a slot (admins or the slot's coach)",
        "operationId" : "updateSlot",
        "parameters" : [ {
          "name" : "slotId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateSlotRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "404" : {
            "description" : "Slot not found in the caller's organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "slots" ],
        "summary" : "Delete a slot and its memberships (admins or the slot's coach)",
        "operationId" : "deleteSlot",
        "parameters" : [ {
          "name" : "slotId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "description" : "Slot not found in the caller's organization"
          },
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/slots" : {
      "get" : {
        "tags" : [ "slots" ],
        "summary" : "List the club's slots with coach and group members",
        "operationId" : "listSlots",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/SlotResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "slots" ],
        "summary" : "Create a weekly slot (coaches: own slots only; admins: any eligible coach)",
        "operationId" : "createSlot",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateSlotRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "403" : {
            "description" : "Coach tried to create a slot for someone else",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Target coach is not an active coach or admin",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          },
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/slots/{slotId}/members" : {
      "post" : {
        "tags" : [ "slots" ],
        "summary" : "Add an active member to the slot's group (admins or the slot's coach)",
        "operationId" : "addMember",
        "parameters" : [ {
          "name" : "slotId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AddSlotMemberRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "404" : {
            "description" : "Slot or member not found in the caller's organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Member is pending/disabled or already in the slot",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          },
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/slots/{slotId}/changes" : {
      "post" : {
        "tags" : [ "slots" ],
        "summary" : "Cancel or move one session at a given date — notifies the slot's group in-app",
        "operationId" : "createChange",
        "parameters" : [ {
          "name" : "slotId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateSlotChangeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "400" : {
            "description" : "Date in the past / not on the slot's weekday / bad newStartTime",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Slot not found in the caller's organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "This session is already cancelled or moved",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          },
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts" : {
      "post" : {
        "tags" : [ "feed" ],
        "summary" : "Publish an INFO or CANCELLATION post (ORG audience: admins; COACH_STUDENTS: coaches)",
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreatePostRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "403" : {
            "description" : "Role not allowed to publish to the requested audience",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPostResponse"
                }
              }
            }
          },
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPostResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/poster" : {
      "post" : {
        "tags" : [ "feed" ],
        "summary" : "Publish a POSTER post with an image (content-sniffed JPEG/PNG/WebP, max 5 MB)",
        "operationId" : "createPoster",
        "requestBody" : {
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "meta" : {
                    "$ref" : "#/components/schemas/CreatePosterRequest"
                  },
                  "image" : {
                    "type" : "string",
                    "format" : "binary"
                  }
                },
                "required" : [ "image", "meta" ]
              }
            }
          }
        },
        "responses" : {
          "400" : {
            "description" : "File content is not a supported image",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPostResponse"
                }
              }
            }
          },
          "403" : {
            "description" : "Role not allowed to publish to the requested audience",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPostResponse"
                }
              }
            }
          },
          "201" : {
            "description" : "Created",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPostResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications/read-all" : {
      "post" : {
        "tags" : [ "notifications" ],
        "summary" : "Mark all the caller's notifications as read",
        "operationId" : "readAll",
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    },
    "/api/members/{memberId}/approve" : {
      "post" : {
        "tags" : [ "members" ],
        "summary" : "Approve a pending member (admins only)",
        "operationId" : "approve",
        "parameters" : [ {
          "name" : "memberId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "description" : "Member not found in the caller's organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Member is not pending",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register" : {
      "post" : {
        "tags" : [ "auth" ],
        "summary" : "Register a new account, creating or joining an organization",
        "operationId" : "register",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Account created and session established",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "joinSlug does not match any organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "409" : {
            "description" : "Email already registered",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login" : {
      "post" : {
        "tags" : [ "auth" ],
        "summary" : "Authenticate with email and password (server session cookie)",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Session established",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "Invalid credentials",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/members/{memberId}/role" : {
      "patch" : {
        "tags" : [ "members" ],
        "summary" : "Change a member's role (admins only, OWNER excluded)",
        "operationId" : "changeRole",
        "parameters" : [ {
          "name" : "memberId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateRoleRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "404" : {
            "description" : "Member not found in the caller's organization",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MemberResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications" : {
      "get" : {
        "tags" : [ "notifications" ],
        "summary" : "Latest notifications of the caller, with the unread count",
        "operationId" : "list",
        "parameters" : [ {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NotificationPageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/members" : {
      "get" : {
        "tags" : [ "members" ],
        "summary" : "List active members of the caller's organization",
        "operationId" : "listMembers",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/MemberResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/members/pending" : {
      "get" : {
        "tags" : [ "members" ],
        "summary" : "List members awaiting approval (admins only)",
        "operationId" : "listPendingMembers",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PendingMemberResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/feed" : {
      "get" : {
        "tags" : [ "feed" ],
        "summary" : "Aggregated feed of the caller: ORG posts plus COACH_STUDENTS posts they can see",
        "operationId" : "feed",
        "parameters" : [ {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/FeedPageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me" : {
      "get" : {
        "tags" : [ "auth" ],
        "summary" : "Current authenticated user profile",
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/csrf" : {
      "get" : {
        "tags" : [ "auth" ],
        "summary" : "Prime the CSRF cookie and return the current token",
        "operationId" : "csrf",
        "parameters" : [ {
          "name" : "token",
          "in" : "query",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/CsrfToken"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "object",
                  "additionalProperties" : {
                    "type" : "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/slots/{slotId}/members/{userId}" : {
      "delete" : {
        "tags" : [ "slots" ],
        "summary" : "Remove a member from the slot's group (admins or the slot's coach)",
        "operationId" : "removeMember",
        "parameters" : [ {
          "name" : "slotId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "userId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "description" : "Slot or membership not found",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/slots/{slotId}/changes/{changeId}" : {
      "delete" : {
        "tags" : [ "slots" ],
        "summary" : "Revert a session cancellation/move (admins or the slot's coach)",
        "operationId" : "deleteChange",
        "parameters" : [ {
          "name" : "slotId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "changeId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "description" : "Slot or change not found",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts/{postId}" : {
      "delete" : {
        "tags" : [ "feed" ],
        "summary" : "Delete a post (author or admins)",
        "operationId" : "delete",
        "parameters" : [ {
          "name" : "postId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "404" : {
            "description" : "Post not found in the caller's organization"
          },
          "204" : {
            "description" : "No Content"
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "UpdateSlotRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "dayOfWeek" : {
            "type" : "string",
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ]
          },
          "startTime" : {
            "type" : "string",
            "format" : "partial-time",
            "example" : "18:00"
          },
          "durationMinutes" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 600,
            "minimum" : 15
          }
        },
        "required" : [ "dayOfWeek", "durationMinutes", "name", "startTime" ]
      },
      "SlotChangeResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "date" : {
            "type" : "string",
            "format" : "date"
          },
          "action" : {
            "type" : "string",
            "enum" : [ "CANCELLED", "MOVED" ]
          },
          "newStartTime" : {
            "type" : "string",
            "format" : "partial-time",
            "example" : "19:00"
          },
          "note" : {
            "type" : "string"
          }
        }
      },
      "SlotMemberResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "displayName" : {
            "type" : "string"
          }
        }
      },
      "SlotResponse" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "dayOfWeek" : {
            "type" : "string",
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ]
          },
          "startTime" : {
            "type" : "string",
            "format" : "partial-time",
            "example" : "18:00"
          },
          "durationMinutes" : {
            "type" : "integer",
            "format" : "int32"
          },
          "coachId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "coachDisplayName" : {
            "type" : "string"
          },
          "members" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SlotMemberResponse"
            }
          },
          "changes" : {
            "type" : "array",
            "description" : "Upcoming cancelled/moved sessions",
            "items" : {
              "$ref" : "#/components/schemas/SlotChangeResponse"
            }
          }
        }
      },
      "CreateSlotRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0
          },
          "dayOfWeek" : {
            "type" : "string",
            "enum" : [ "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY" ]
          },
